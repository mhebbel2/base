export TERM=screen-256color
export EDITOR=nvim
export PATH=$HOME/.local/bin:$PATH
export PROJECTS=$HOME/projects

export PATH=$PATH:$PROJECTS/base/bin
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

if [[ "$PREFIX" !=  *"/com.termux/"* ]] && command -v loginctl &>/dev/null; then
	if [ -z "$DISPLAY" ]; then
		export DISPLAY=$(loginctl show-session $(loginctl | grep $USER | awk '{print $1}') -p Display --value 2>/dev/null)
		# Fallback if loginctl fails
		[ -z "$DISPLAY" ] && export DISPLAY=:10.0
	fi
fi

if [ -f "$HOME/.local/tokens.sh" ]; then
    source "$HOME/.local/tokens.sh"
fi

bind '"jp": "cd $(find $PROJECTS -maxdepth 1 -type d -not -path \"*/.*\" | fzf --reverse --height 30%);pwd\n"'

eval "$(ssh-agent -s)" >/dev/null

alias v=nvim

if command -v git &>/dev/null; then
	alias g=git
	alias gq='git commit -am "update" && git push'
	alias gs='git status -b --porcelain=1'
fi

if command -v fzf &>/dev/null; then
	source <(fzf --bash)
fi

if command -v opencode &>/dev/null; then
	source <(opencode completion)
fi

stty -ixon 2>/dev/null

shopt -s huponexit
shopt -s histappend
shopt -s checkwinsize
export HISTCONTROL=ignoreboth

export PS1=". "
