#!/bin/bash

repo=$({ gh repo list --no-archived --json sshUrl --jq '.[].sshUrl' -L 400; gh repo list --no-archived --json sshUrl --jq '.[].sshUrl' -L 400 chainstep; } | sort -u | fzf)
git clone $repo $PROJECTS/$(basename $repo .git)
cd $PROJECTS/$(basename $repo .git)
pwd
$PROJECTS/base/bin/set_git_config.sh
