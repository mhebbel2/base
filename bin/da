#!/bin/bash

export SESSION_DIR=$HOME/.local/sessions
mkdir -p $SESSION_DIR

if [ -n "$DA_SESSION" ]; then
	echo "You are already in a session. Please detach first."
	exit
fi

options=("_new")
while IFS= read -r line; do
options+=("$line")
done < <(/bin/ls "$SESSION_DIR" 2>/dev/null)

session_name=$( printf '%s\n' "${options[@]}" | fzf --select-1)

if [ "$session_name" = "_new" ]; then
	read -p "Enter new session name: " new_session_name
	session_name=$new_session_name
fi

dtach -A $SESSION_DIR/$session_name bash -c "export DA_SESSION=${session_name}; bash"
